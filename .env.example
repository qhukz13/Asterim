# Asterim Core configuration
# Copy to .env only if you want to override defaults. Every variable here is
# read by the code (apps/server). Anything not listed is not read.

# HTTP + Socket.IO port. Stable channel defaults to 3000, dev channel to 3001.
# PORT=3000

# Listen address. `::` accepts LAN connections (needed for phone/tablet pairing).
# Use 127.0.0.1 to keep the Core private to this machine.
# HOST=::

# `stable` (default) uses ~/.asterim, `dev` uses ~/.asterim-dev and port 3001.
# ASTERIM_CHANNEL=stable

# Override the data directory (database, logs, vault salt, loopback descriptor).
# ASTERIM_DATA_DIR=/path/to/dir

# Air-gap switch: no relay, no push, no remote AI providers.
# ASTERIM_SOVEREIGN_MODE=true

# Developer convenience only: lets loopback requests without a token act as a
# local user on the dev channel. Never set this on a machine you share.
# ASTERIM_DEV_AUTH_BYPASS=true

# Replace the Antigravity adapter with a scripted mock (demos, CI).
# MOCK_AGENT=true

# Path to the Claude Code binary if it is not on PATH.
# ASTERIM_CLAUDE_BIN=/usr/local/bin/claude

# Make Asterim's approval card the only permission decider for the Claude Code
# sessions it runs, by disabling every hook in your Claude Code settings for
# those sessions. Off by default: your own hooks keep working, and a hook that
# allows a tool call is reported in the thread log instead of asking you.
# ASTERIM_CLAUDE_DISABLE_HOOKS=true

# --- Optional cloud features (all off by default) ---
# ASTERIM_RELAY_URL=https://relay.example.com
# ASTERIM_RELAY_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_TEAM=
# Local testing only: process Stripe webhooks without a signature.
# ASTERIM_ALLOW_UNSIGNED_STRIPE_WEBHOOKS=true

# Production hardening: disables every development fallback.
# NODE_ENV=production
