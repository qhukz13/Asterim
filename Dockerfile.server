# syntax=docker/dockerfile:1
#
# Asterim Core Server — the privileged process that owns SQLite, the EventBus,
# agent lifecycle and git. Build from the repository root:
#
#   docker build -f Dockerfile.server -t asterim-server .
#
# See docs/operations-runbook.md for configuration and deployment recipes.

##############################################################################
# Stage 1 — builder
##############################################################################
FROM node:22-alpine AS builder

# node-pty is a native addon and is compiled here, against the same musl libc
# the runner stage uses. None of this toolchain reaches the final image.
RUN apk add --no-cache python3 make g++

ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate

WORKDIR /repo

# The visual-QA tool is a workspace devDependency and downloads a browser on
# install. Nothing in an image needs it.
ENV PUPPETEER_SKIP_DOWNLOAD=true

# Manifests and the lockfile first: a source-only change then reuses the cached
# dependency layer instead of re-resolving the whole workspace.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.base.json ./
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
COPY apps/relay/package.json apps/relay/
COPY apps/marketing/package.json apps/marketing/
COPY packages/shared/package.json packages/shared/
COPY packages/adapters/package.json packages/adapters/
COPY packages/config-eslint/package.json packages/config-eslint/
COPY packages/mcp-memory-server/package.json packages/mcp-memory-server/
RUN pnpm install --frozen-lockfile

COPY . .

# turbo resolves the graph: asterim#build depends on @asterim/web#build, whose
# output the server's own build script copies into dist/web and serves. The
# marketing site and the relay are not built — they are not part of this image.
RUN pnpm exec turbo run build --filter=asterim

# A self-contained tree with production dependencies only. tsup bundles
# @asterim/shared and @asterim/adapters into dist/index.js, so what remains here
# is the handful of packages it deliberately left external (node-pty, fastify,
# socket.io, simple-git, …).
RUN pnpm --filter=asterim --prod deploy /app

# Two kinds of dead weight from the native build. node-gyp leaves its
# intermediate objects behind, and node-pty ships prebuilt addons for macOS and
# Windows — on Linux it loads the one compiled in the builder stage, so those
# are ~58MB that can never be opened.
RUN find /app/node_modules -type d -name obj.target -prune -exec rm -rf {} + \
 && find /app/node_modules -type f -name '*.o' -delete \
 && for d in $(find /app/node_modules -type d -name prebuilds); do \
      find "$d" -mindepth 1 -maxdepth 1 -type d ! -name 'linux-*' -exec rm -rf {} +; \
    done

##############################################################################
# Stage 2 — runner
##############################################################################
FROM node:22-alpine AS runner

ENV NODE_ENV=production
# All mutable state — asterim.db, its WAL sidecars, crash.log — lives here, and
# DatabaseService restricts the directory to 0700 and the database to 0600.
ENV ASTERIM_DATA_DIR=/home/node/.asterim

WORKDIR /app
COPY --from=builder --chown=node:node /app ./

RUN mkdir -p /home/node/.asterim && chown -R node:node /home/node/.asterim /app
VOLUME /home/node/.asterim

# Never root. The image ships no shell tooling beyond what Alpine's base has,
# and the process needs no privilege it cannot get as `node`.
USER node

EXPOSE 3000

# Node 22 has fetch built in, so the probe needs no curl or wget in the image.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "dist/index.js"]
